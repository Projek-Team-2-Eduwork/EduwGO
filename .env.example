APP_NAME=EduwGo
APP_ENV=local
APP_KEY=
# Production: APP_ENV=production dan APP_DEBUG=false (stack trace & env tidak boleh tampil).
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB terkelola (mis. Aiven, docs/DEPLOY.md): path CA server, koneksi jadi TLS terverifikasi.
# Kosongkan untuk lokal/Sail (tanpa SSL, perilaku tidak berubah). Jangan commit file CA/kredensial.
# MYSQL_ATTR_SSL_CA=/etc/secrets/aiven-ca.pem
# Alternatif khusus image produksi (docker/production/entrypoint.sh): isi PEM langsung,
# entrypoint menulisnya ke /tmp/mysql-ca.pem dan mengisi MYSQL_ATTR_SSL_CA otomatis.
# MYSQL_SSL_CA_PEM="-----BEGIN CERTIFICATE-----..."
# MYSQL_SSL_CA_BASE64=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): SESSION_SECURE_COOKIE=true agar cookie sesi tidak terkirim lewat http.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Email status booking (SendBookingStatusEmail) masuk queue -> butuh `artisan queue:work`.
# Di Render/hosting tanpa worker pakai QUEUE_CONNECTION=sync. Email verifikasi & reset password
# dikirim langsung (tidak lewat queue).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Produksi di Render free: Brevo SMTP (port 2525; 25/465/587 diblokir Render) ---
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=2525
# MAIL_USERNAME=login-smtp@smtp-brevo.com
# MAIL_PASSWORD=smtp-key-brevo
# MAIL_FROM_ADDRESS="sender-terverifikasi@domain.com"
# MAIL_FROM_NAME="${APP_NAME}"

# --- Contoh Gmail SMTP (App Password), hanya untuk lokal ---
# Butuh verifikasi 2 langkah aktif di akun Google. Pakai akun Gmail khusus proyek.
# Ganti blok MAIL_* di atas dengan ini, JANGAN commit nilai asli. Lalu: artisan config:clear
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=akun-proyek@gmail.com
# MAIL_PASSWORD=app-password-16-karakter
# MAIL_FROM_ADDRESS="akun-proyek@gmail.com"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Xendit (rental motor, docs/SPEC.md bagian 3)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# payment_request = halaman bayar sendiri (aktif), invoice = rollback (docs/pembayaran-xendit.md)
# XENDIT_MODE=payment_request

# Token endpoint POST /cron/run (header Authorization: Bearer <token>) untuk cron eksternal
# di hosting tanpa scheduler (docs/DEPLOY.md). Kosong = endpoint selalu menolak (401).
# Buat nilai acak panjang, mis. `php -r "echo bin2hex(random_bytes(32));"`
CRON_TOKEN=

# Image produksi (docs/DEPLOY.md): true = `migrate --force` setiap container start. Default false.
# RUN_MIGRATIONS=false
# Produksi HTTPS: cookie sesi hanya lewat HTTPS
# SESSION_SECURE_COOKIE=true

# Password akun UserSeeder (superadmin/admin/demo). Kosong di lokal = "password".
# Production WAJIB diisi (min. 12 karakter), kalau tidak seeder menolak berjalan.
# SEED_USER_PASSWORD=

# Sail
APP_PORT=80
FORWARD_DB_PORT=3306
FORWARD_PHPMYADMIN_PORT=8080
